# SPOMigrate configuration example.
# Copy to .env (git-ignored) and fill in. Or run:  ./migration.ps1 -Setup
#
# Precedence (lowest -> highest):
#   config/settings.psd1  ->  .env  ->  SPO_* env vars  ->  CLI parameters

# --- Connection (required) ---
SPO_TENANT_ID=contoso.onmicrosoft.com
SPO_CLIENT_ID=00000000-0000-0000-0000-000000000000
SPO_CERT_THUMBPRINT=ABCDEF0123456789ABCDEF0123456789ABCDEF01
SPO_DEST_SITE_URL=https://contoso.sharepoint.com/sites/Archive

# --- Destination + inventory ---
SPO_DEST_LIBRARY=Shared Documents
SPO_SITES_CSV=config/sites.csv

# --- Throughput ---
SPO_SITE_THROTTLE=4
SPO_FILE_THROTTLE=5
SPO_RPS=25
SPO_MAX_RETRIES=6
SPO_PAGE_SIZE=500

# --- Delta / verify ---
# SPO_DELTA_CUTOFF=2026-06-25 00:00:00
SPO_VERIFY_HASH=false

# --- Paths ---
SPO_LOG_DIR=logs
SPO_REPORT_DIR=reports
# SPO_TEMP_DIR=C:\Temp\SPOMigrate
